# Copy to secrets.properties (same folder, not tracked by git) and fill in the real values.
# Every key is optional: a missing key builds as an empty string.

# Samsung Knox license key (app: Knox/license/Const.KNOX_LICENSE_SDK_KEY)
KNOX_LICENSE_SDK_KEY=KLM00-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX
# Knox B2B device password, sent MD5-hashed (app: Knox/license/Const.BASIC_PASSWORD)
KNOX_BASIC_PASSWORD=change-me
# Device password hash for the authenticate API (app: Extra/Consts.defaultPassword)
DEFAULT_PASSWORD=00000000000000000000000000000000
# AES key for the stored PIN (app: Extra/AESCrypt); must stay identical to decrypt existing data
AES_KEY=0000000000000000

# Xirsys TURN/STUN credentials (screenshare: StartStopScreenShare.getIceServers)
XIRSYS_IDENT=your-xirsys-ident
XIRSYS_SECRET=your-xirsys-secret
